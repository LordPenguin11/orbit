{
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "orbit-projects",
  "name": "Orbit Projects",
  "version": "0.4.0",
  "description": "Kanban board of the repo's .orbit tasks with the agents working on them.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "pluginApi": 1,
  "main": "worker/main.mjs",
  "contributes": {
    "panels": [
      {
        "id": "board",
        "title": "Orbit",
        "icon": "layers",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      }
    ],
    "hooks": [
      {
        "event": "agent.tool.before"
      },
      {
        "event": "agent.prompt.before"
      }
    ],
    "settings": [
      {
        "key": "guardMode",
        "title": "Agent guard",
        "description": "block: remind agents and refuse file edits (Claude Code only) until a task is claimed. remind: only add a reminder to prompts Orca sends. off: do nothing.",
        "type": "string",
        "enum": [
          "block",
          "remind",
          "off"
        ],
        "enumLabels": [
          "Remind and block",
          "Remind only",
          "Off"
        ],
        "default": "block"
      },
      {
        "key": "orcaCli",
        "title": "Orca CLI path",
        "description": "Used to interrupt agents when you save a task they are working on. Leave empty to find it automatically.",
        "type": "string",
        "default": ""
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "storage:own"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "terminal:send"
    }
  ]
}
